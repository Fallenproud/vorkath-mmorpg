{
  "name": "vorkathprime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/manus-game-assets/restore.mjs && vite",
    "dev:api": "PORT=${API_PORT:-3001} node server/index.mjs",
    "build": "node scripts/manus-game-assets/restore.mjs && node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "dev:local": "vite",
    "build:static": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview:static": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1",
    "@trpc/client": "^11.6.0",
    "superjson": "^1.13.3"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0"
}
